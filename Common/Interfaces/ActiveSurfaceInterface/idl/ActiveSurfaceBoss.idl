#ifndef _ACTIVESURFACEBOSS_IDL_
#define _ACTIVESURFACEBOSS_IDL_

#include <baci.idl>
#include <ComponentErrors.idl>
#include <ASErrors.idl>
#include <ActiveSurfaceCommon.idl>
#include <ManagmentDefinitions.idl>

#pragma prefix "alma"

module ActiveSurface
{
    /**
     * Supervisor of the Active Surface subsystem. Coordinates all Sectors,
     * broadcasting configuration and tracking commands.
     */
	interface ActiveSurfaceBoss: ACS::CharacteristicComponent, Management::CommandInterpreter, Management::Subsystem
    {
        // ---------------------------------------------------------------
        // Status attributes
        // ---------------------------------------------------------------

		readonly attribute Management::ROTBoolean tracking;
        readonly attribute ROTASProfile profile;
        readonly attribute ACS::ROstring LUT;

        // ---------------------------------------------------------------
        // Configuration
        // ---------------------------------------------------------------

        void setLUT(in string lutName) raises (ComponentErrors::ComponentErrorsEx, ASErrors::ASErrorsEx);
        void setProfile(in TASProfile profile) raises (ComponentErrors::ComponentErrorsEx, ASErrors::ASErrorsEx);

        // ---------------------------------------------------------------
        // Tracking control
        // ---------------------------------------------------------------

        void asOn() raises (ComponentErrors::ComponentErrorsEx);
        void asOff() raises (ComponentErrors::ComponentErrorsEx);
    };
};

#endif
