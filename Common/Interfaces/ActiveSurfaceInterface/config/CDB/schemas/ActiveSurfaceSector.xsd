<?xml version="1.0" encoding="UTF-8"?>

<xs:schema
  targetNamespace="urn:schemas-cosylab-com:ActiveSurfaceSector:1.0"
  xmlns:xs="http://www.w3.org/2001/XMLSchema"
  xmlns="urn:schemas-cosylab-com:ActiveSurfaceSector:1.0"
  xmlns:cdb="urn:schemas-cosylab-com:CDB:1.0"
  xmlns:baci="urn:schemas-cosylab-com:BACI:1.0"
  elementFormDefault="qualified"
  attributeFormDefault="unqualified">

  <xs:import namespace="urn:schemas-cosylab-com:CDB:1.0" schemaLocation="CDB.xsd"/>
  <xs:import namespace="urn:schemas-cosylab-com:BACI:1.0" schemaLocation="BACI.xsd"/>

  <xs:complexType name="typeActiveSurfaceSector">
   <xs:complexContent>
    <xs:extension base="baci:CharacteristicComponent">
     <xs:sequence>
      <xs:element name="index" type="baci:ROlong"/> 
      <xs:element name="ready" type="baci:ROboolean"/> 
     </xs:sequence>
    </xs:extension>
   </xs:complexContent>
  </xs:complexType>

  <xs:element name="ActiveSurfaceSector" type="typeActiveSurfaceSector"/>

</xs:schema>
